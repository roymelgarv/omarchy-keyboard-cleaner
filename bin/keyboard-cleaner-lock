#!/usr/bin/env bash
# Disable / re-enable Hyprland input devices for a keyboard-cleaning session.
#
#   keyboard-cleaner-lock lock <device> [<device>...]
#   keyboard-cleaner-lock unlock
#   keyboard-cleaner-lock status
#   keyboard-cleaner-lock keys-down
#
# Mechanism. Hyprland's per-device `enabled` flag is checked at the very top of
# CInputManager::onKeyboardKey and onKeyboardMod, so a disabled keyboard
# delivers nothing at all -- not keys, not modifiers, not keybinds, not IME,
# and it does not even reset the idle timer. That is a far harder block than a
# catchall submap, which leaks every modifier and every modified key because
# binds are filtered by modmask before the catchall branch is reached.
#
# Recovery, by design and in order of escalation:
#   1. The unlock button in the overlay.
#   2. The session's auto-expiry timer.
#   3. `keyboard-cleaner-lock unlock` over SSH.
#   4. Any Hyprland config reload -- `omarchy-restart-hyprctl`, a theme switch,
#      or touching ~/.config/hypr/hyprland.lua. Reload clears m_deviceConfigs
#      and every device defaults back to enabled.
#   5. A TTY. The block is compositor-side, so Ctrl+Alt+F2 is unaffected.
#
# State lives in $XDG_RUNTIME_DIR (tmpfs), so a reboot cannot inherit a locked
# session. It is deliberately NOT written to
# ~/.local/state/omarchy/toggles/hypr/, which Hyprland sources on every reload:
# persisting a keyboard disable there would survive reboot and lock you out for
# good.

set -euo pipefail

STATE_DIR="${XDG_RUNTIME_DIR:-/tmp}/keyboard-cleaner"
STATE_FILE="$STATE_DIR/locked.json"
PROBE_FILE="$STATE_DIR/keyprobe"
KEY_TIMEOUT="${KEYBOARD_CLEANER_KEY_TIMEOUT:-5}"

command -v hyprctl >/dev/null || { echo "keyboard-cleaner: hyprctl not found" >&2; exit 1; }

# Which physical keys are held right now, as evdev keycodes, comma separated.
#
# This matters because a key held at the moment its device is disabled never
# delivers its release: onKeyboardKey returns early on !m_enabled, so the
# focused client keeps the key latched forever. The classic way to hit it is
# the keybinding trigger -- SUPER and SHIFT are both physically down at the
# instant the bind fires, so both would stick.
#
# `hyprctl eval` reports only "ok" and never the chunk's value, so the Lua side
# writes its answer to a file we read back. hl.is_key_down reflects physical
# device state (Hyprland's m_pressed), which is exactly the state that would be
# stranded; synthetic events do not appear here.
held_keys() {
  mkdir -p "$STATE_DIR"
  : >"$PROBE_FILE"
  hyprctl eval "local d={} for kc=1,255 do if hl.is_key_down(kc) then d[#d+1]=kc end end local f=io.open('$PROBE_FILE','w') if f then f:write(table.concat(d,',')) f:close() end" \
    >/dev/null 2>&1 || true
  cat "$PROBE_FILE" 2>/dev/null || true
}

# Block until every key is up, so the disable lands on a clean keyboard state.
# Bounded, because a genuinely stuck key must not make the plugin unusable --
# on timeout we lock anyway and say so.
wait_for_key_release() {
  # Counted rather than clock-based: bash's SECONDS ticks on wall-clock
  # boundaries, so a "2 second" deadline can elapse in barely over one.
  local -r poll=0.1 attempts=$(awk -v t="$KEY_TIMEOUT" 'BEGIN { printf "%d", (t / 0.1) + 1 }')
  local held i
  for ((i = 0; i < attempts; i++)); do
    held=$(held_keys)
    [[ -n "$held" ]] || return 0
    sleep "$poll"
  done
  echo "keyboard-cleaner: keys $held still held after ${KEY_TIMEOUT}s; locking anyway" >&2
  return 1
}

set_enabled() {
  local device=$1 value=$2
  # Omarchy runs Hyprland's Lua config, where `hyprctl keyword device[...]` is
  # the legacy hyprlang syntax and does nothing. `hyprctl eval` is how
  # omarchy-toggle-input-device drives the same knob.
  hyprctl eval "hl.device({ name = \"$device\", enabled = $value })" >/dev/null
}

cmd_lock() {
  [[ $# -gt 0 ]] || { echo "keyboard-cleaner: lock needs at least one device" >&2; exit 2; }

  # Record the intent before touching a single device. If this process is
  # killed midway, `unlock` still knows the full set to restore.
  mkdir -p "$STATE_DIR"
  printf '%s\n' "$@" | jq -Rsc \
    --argjson at "$(date +%s)" \
    'split("\n") | map(select(length > 0)) | {devices: ., lockedAt: $at}' \
    >"$STATE_FILE"

  # Let go of the keyboard before we take it away.
  wait_for_key_release || true

  local device
  for device in "$@"; do
    set_enabled "$device" false
  done
}

cmd_unlock() {
  # Re-enable from the state file when there is one. Absent that -- a stale
  # session, a lost runtime dir -- fall back to re-enabling every device
  # Hyprland currently reports, which is safe: enabling an already-enabled
  # device is a no-op.
  local devices=()
  if [[ -r "$STATE_FILE" ]]; then
    mapfile -t devices < <(jq -r '.devices[]' "$STATE_FILE" 2>/dev/null || true)
  fi
  if [[ ${#devices[@]} -eq 0 ]]; then
    mapfile -t devices < <(hyprctl devices -j | jq -r '.keyboards[].name, .mice[].name')
  fi

  local device
  for device in "${devices[@]}"; do
    set_enabled "$device" true
  done
  rm -f "$STATE_FILE"
}

cmd_status() {
  if [[ -r "$STATE_FILE" ]]; then cat "$STATE_FILE"; else echo '{"devices":[],"lockedAt":0}'; fi
}

case "${1:-}" in
  lock)      shift; cmd_lock "$@" ;;
  unlock)    cmd_unlock ;;
  status)    cmd_status ;;
  keys-down) held_keys; echo ;;
  *) echo "usage: keyboard-cleaner-lock {lock <device>...|unlock|status|keys-down}" >&2; exit 2 ;;
esac
